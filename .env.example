# Replace placeholders locally; never commit your populated .env.
USERS_JSON='[{"id":"person1","name":"Person One","whatsappIds":["COUNTRYCODE_NUMBER@c.us"]},{"id":"person2","name":"Person Two","whatsappIds":["COUNTRYCODE_NUMBER@c.us"]}]'
TIMEZONE=Asia/Karachi
CURRENCY=PKR
GOOGLE_SHEET_ID=replace-with-sheet-id
# Entire service-account JSON on ONE line, inside single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"replace","private_key":"replace"}'
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
# Optional: exactly 10 unique labels; loans are separate commands.
CATEGORIES_JSON='["House expenses","Groceries","Fuel","Dine-out","Sports","Utilities","Shopping","Health","Travel","Other"]'
DATA_DIR=./data
WHATSAPP_CLIENT_ID=expense-tracker
# Required on Linux when using system Chromium, especially ARM Oracle VMs.
CHROME_EXECUTABLE_PATH=
# false is preferred; true only if your Chromium environment requires it.
CHROME_NO_SANDBOX=false
SHOW_QR=false
SESSION_TTL_MINUTES=15
