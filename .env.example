# Copy this file to .env, then replace the placeholders with your own values.
# Commit .env.example only. Your populated .env is ignored by Git.
# For GitHub deployment, save the COMPLETE populated .env as the ENV_FILE secret.

# Start exactly one transport: whatsapp or discord. Restart after changing it.
BOT_TRANSPORT=whatsapp

# USERS: replace the fictional names and identities below.
# id: a unique internal account ID using lowercase letters, numbers, _ or -;
#     start with a letter. Keep it unchanged once expenses have been recorded.
# name: a unique display name. Do not use "household" as an id or name.
# whatsappIds: international phone digits followed by @c.us, without + or spaces.
#              Add the actual @lid identity too if WhatsApp uses it for that user.
# discordIds: each person's numeric USER ID as a quoted string, not a server ID.
# Only identities for the selected transport are required. You can keep both.
# Add/remove user objects as needed; keep the JSON enclosed in single quotes.
USERS_JSON='[{"id":"person_one","name":"Person One","whatsappIds":["1234567890@c.us"],"discordIds":["123456789012345678"]},{"id":"person_two","name":"Person Two","whatsappIds":["2345678901@c.us"],"discordIds":["234567890123456789"]}]'

# GOOGLE SHEETS: required for either transport.
# From https://docs.google.com/spreadsheets/d/SHEET_ID/edit, copy SHEET_ID.
# Enable the Google Sheets API and share the sheet with your service account
# as an Editor. The bot creates its Ledger tab.
GOOGLE_SHEET_ID=YOUR_GOOGLE_SPREADSHEET_ID
# Replace this entire example object with the COMPLETE downloaded service-account
# JSON, keeping it inside single quotes. Multiline JSON is supported.
# Preserve the original literal \n escapes within the private_key field.
GOOGLE_SERVICE_ACCOUNT_JSON='{
  "type": "service_account",
  "project_id": "YOUR_GOOGLE_CLOUD_PROJECT_ID",
  "private_key_id": "YOUR_PRIVATE_KEY_ID",
  "private_key": "YOUR_COMPLETE_PRIVATE_KEY_WITH_ORIGINAL_ESCAPED_NEWLINES",
  "client_email": "YOUR_SERVICE_ACCOUNT_EMAIL",
  "client_id": "YOUR_SERVICE_ACCOUNT_CLIENT_ID",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "YOUR_SERVICE_ACCOUNT_CERTIFICATE_URL",
  "universe_domain": "googleapis.com"
}'

# DISCORD: required only when BOT_TRANSPORT=discord.
# Create an application at https://discord.com/developers/applications.
# On its Bot page, generate a token and paste it here. This is not a client secret.
DISCORD_BOT_TOKEN=
# Leave empty for DMs only. Otherwise paste ONE server text-channel ID.
# Channel links look like https://discord.com/channels/SERVER_ID/CHANNEL_ID.
# Enable Message Content Intent on the Bot page when using a server channel.
# Allowlisted users can still DM the bot when a channel is configured.
DISCORD_CHANNEL_ID=

# WHATSAPP: used only when BOT_TRANSPORT=whatsapp.
# Keep the client ID and DATA_DIR stable to reuse the linked-device session.
WHATSAPP_CLIENT_ID=expense-tracker
# Optional locally; required when using system Chromium on a Linux VM.
# Example Linux path: /usr/bin/chromium. Leave empty for Puppeteer's browser.
CHROME_EXECUTABLE_PATH=
# Keep false unless your Chromium environment requires disabling its sandbox.
CHROME_NO_SANDBOX=false
# Temporarily set true for pairing in a PRIVATE terminal, then change back.
SHOW_QR=false

# COMMON SETTINGS: months and dates use this IANA timezone.
TIMEZONE=Asia/Karachi
CURRENCY=PKR
# Preserve this directory across deployments; an absolute path is recommended
# on a VM. It stores pending prompts and, for WhatsApp, authentication state.
DATA_DIR=./data
SESSION_TTL_MINUTES=15

# CATEGORIES: unique starting labels. Custom categories can be added later.
# Short-term and Long-term are added automatically if omitted from an older env.
CATEGORIES_JSON='["House expenses","Groceries","Fuel","Dine-out","Sports","Utilities","Shopping","Health","Travel","Other","Short-term","Long-term"]'
# House expenses, Groceries and Fuel use ONE shared household budget.
HOUSEHOLD_CATEGORIES_JSON='["House expenses","Groceries","Fuel"]'
# Each person has their own individual, Shopping & Dine-out, and Investments
# budgets. Both investment categories share that person's Investments budget.
# Each built-in monthly budget defaults to this amount unless explicitly set
# for that month. Household has one shared limit, not one limit per person.
DEFAULT_MONTHLY_BUDGET=25000
# These select category labels, not separate funding budgets. Both categories
# share ONE Shopping & Dine-out limit per person.
SHOPPING_CATEGORY=Shopping
DINE_OUT_CATEGORY=Dine-out

# OPTIONAL GEMINI: only "gemini <request>" invokes translation.
# To enable it, set GEMINI_ENABLED=true and supply your own API key.
# Get a key at https://aistudio.google.com/ and choose a model your account supports.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
